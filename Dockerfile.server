# Docker build for Node server
FROM node:22-alpine

# Install pnpm
RUN npm install -g pnpm

# Set working directory
WORKDIR /app

# Copy only necessary configuration files
COPY pnpm-workspace.yaml ./
COPY package.json tsconfig.base.json ./

# Copy common and server package files
COPY packages/common/package.json ./packages/common/
COPY packages/common/tsconfig.json ./packages/common/
COPY packages/server/package.json ./packages/server/
COPY packages/server/tsconfig.json ./packages/server/

# Install dependencies
WORKDIR /app
RUN pnpm install --filter=@mintflow/common --filter=@mintflow/server

# Copy source code for common and server
COPY packages/common/src ./packages/common/src
COPY packages/server/src ./packages/server/src

# Build common package first
WORKDIR /app/packages/common
RUN pnpm run build

# Build server package
WORKDIR /app/packages/server
RUN pnpm run build

EXPOSE 7001
CMD ["node", "dist/index.js"]
