# --- Builder stage ---
FROM node:22-alpine AS builder

WORKDIR /app

# Copy workspace configuration files
COPY package.json ./
COPY pnpm-lock.yaml ./
COPY pnpm-workspace.yaml ./
COPY .npmrc ./

# Create the packages directory structure
RUN mkdir -p packages/ui-web

# Copy the UI web package.json
COPY packages/ui-web/package.json ./packages/ui-web/

# Install pnpm if not present
RUN npm install -g pnpm

# Install dependencies with network retry for better reliability
RUN pnpm install --frozen-lockfile --network-timeout 100000

# Copy the rest of the source code
COPY packages/ui-web/ ./packages/ui-web/

# Build the Next.js app
WORKDIR /app/packages/ui-web
RUN pnpm build
WORKDIR /app

# --- Production image ---
FROM node:22-alpine

WORKDIR /app

RUN npm install -g pnpm

# Copy only the built output and minimal files for runtime
COPY --from=builder /app/packages/ui-web/.next ./.next
COPY --from=builder /app/packages/ui-web/public ./public
COPY --from=builder /app/packages/ui-web/package.json ./
COPY --from=builder /app/pnpm-lock.yaml ./
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/packages/ui-web/next.config.js* ./
COPY --from=builder /app/packages/ui-web/next-i18next.config.js* ./
COPY --from=builder /app/packages/ui-web/tsconfig.json* ./

EXPOSE 3600

CMD ["pnpm", "start"]
